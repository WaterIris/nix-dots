
{
"layer": "top",
"position": "left",
"fixed-center": true,
"reload_style_on_change": true,
"on-sigusr1":"toggle",
"on-sigusr2":"reload",


"modules-left": [
    "clock",
    "pulseaudio",
    "backlight",
    "bluetooth",
    "network",
],

"modules-center": [
    "hyprland/workspaces"
],

"modules-right": [
    "disk",
    "cpu",
    "memory",
    "temperature",
    "battery",
],

"hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "disable-scroll": true,
    "all-outputs": true,
    "persistent-workspaces": {
        "*": [1, 2, 3, 4, 5]
    }
},

"hyprland/window": {
    "format": "󰣆 {title}",
    "max-length": 40,
    "separate-outputs": false,
    "rewrite": {
      "(.*) — Mozilla Firefox": " Firefox",
      "(.*) ": " Empty",
    }
},

"tray": {
	"icon-size": 21,
	"spacing": 10,
},

"clock": {
    "format": "{:%H\n%M}",
    "justify": "center",
    "tooltip-format": "{:%A, %d %B %Y}",
    "locale": "pl_PL.UTF-8",
    "timezones": [ "Europe/Warsaw" ]
},

"cpu": {
    "format": "",
    "interval": 2,
    "tooltip-format": "CPU usage: {usage}%\nLoad average: {load}",
    "states": {
	"critical": 80
    }
},

"memory": {
    "format": "",
    "interval": 2,
    "tooltip-format": "Used: {used} / {total} GiB\nAvailable: {avail} GiB\nSwap: {swapUsed} / {swapTotal} GiB",
    "states": {
	    "critical": 80
    }
},

"disk": {
    "format": "󰋊",
    "interval": 60,
    "tooltip-format": "Path: {path}\nUsed: {used} ({percentage_used}%)\nFree: {free} ({percentage_free}%)\nTotal: {total}",
    "path": "/"
},


"pulseaudio": {
    "on-click": "qs -p ~/.config/quickshell/audiocontrol.qml",
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": ["", "", ""],
    "tooltip-format": "{desc}\nVolume: {volume}%",
    "smooth-scrolling-threshold": 1,
},

"backlight": {
    "format": "{icon}",
    "format-icons": ["󰃜", "󰃞", "󰃟", "󰃝", "󰃠"],
    "tooltip-format": "Screen brightness: {percent}%"
},

"bluetooth": {
	"format": "󰂯",
	"format-connected": "󰂰",
	"format-disabled": "󰂲", 
	"tooltip-format": "Bluetooth on\nNo devices connected",
	"tooltip-format-connected": "Bluetooth on\nConnected: {device_alias}\n{num_connections} device(s) connected",
	"tooltip-format-disabled": "Bluetooth disabled",
},

"network": {
    "on-click": "qs -p ~/.config/quickshell/wificontrol.qml",
    "interval": 1,
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{bandwidthUpBits}   {bandwidthDownBits}\nIP: {ipaddr}/{cidr}\n Freq: {frequency}GHz",
    "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
    "tooltip-format-disconnected": "Disconnected",
},

"temperature": {
    "thermal-zone": 0,
    "format": "",
    "critical-threshold": 80,
    "format-critical": "󰈸",
    "tooltip-format": "Temperature: {temperatureC}°C\nCritical at 80°C",
},

"battery": {
    "format": "{icon}\n{capacity}",
    "justify": "center",
    "format-charging": "\n{capacity}",
    "format-plugged": "\n{capacity}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "interval": 5,
    "tooltip-format": "{timeTo}\nCapacity: {capacity}%\nHealth: {health}%\nPower draw: {power}W",
    "on-update": "~/.config/waybar/scripts/battery-alert.sh",
    "states": {
	"good": 75,
        "warning": 30,
        "critical": 20
    }
},
}
