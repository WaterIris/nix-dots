* {
    /* Tokyo Night palette — matches waybar style.css */
    foreground: #c0caf5;
    foreground-dim: #a9b1d6;
    background: #1a1b26;
    surface: #16161e;
    surface-alt: #292e42;
    subtle: #565f89;
    border: #101014;

    red: #f7768e;
    red-surface: #2b1b26;

    orange: #ff9e64;
    yellow: #e0af68;
    green: #9ece6a;
    teal: #73daca;
    cyan: #7dcfff;

    blue: #7aa2f7;
    blue-surface: #1f2335;

    magenta: #bb9af7;
    magenta-surface: #2b2440;

    background-color: transparent;
    text-color: @foreground;
}


configuration {
    modes: "drun";
    font: "JetBrainsMono Nerd Font Propo SemiBold 14";
    fixed-num-lines: true;
    show-icons: false;
    sidebar-mode: false;
    scroll-method: 1;
    window-format: "{t:50} ·· {c}";
    click-to-exit: true;
    matching: "fuzzy";
    sort: true;
    sorting-method: "levenshtein";
    combi-hide-mode-prefix: false;
    display-drun: "Applications";
    drun-display-format: "{name}";
}

// Same panel as the quickshell menus (wificontrol.qml, keybinds.qml)
window {
    background-color: @background;
    border: 1px;
    border-color: @border;
    border-radius: 6px;
    padding: 16px;
    width: 440px;
    // rofi does not count the header row when sizing the window, which left
    // an empty strip; this fits exactly 7 lines at the 14pt font.
    height: 480px;
}

mainbox {
    spacing: 12px;
    children: [prompt, inputbar, message, listview];
}

// Header: the mode name (e.g. "Applications", or -p for dmenu)
prompt {
    text-color: @foreground;
    padding: 0px 4px;
}

// Search field
inputbar {
    background-color: @surface;
    border: 1px;
    border-color: @blue;
    border-radius: 4px;
    padding: 10px 12px;
    spacing: 10px;
    children: [textbox-search-icon, entry];
}

textbox-search-icon {
    expand: false;
    str: "";
    text-color: @blue;
}

entry {
    text-color: @foreground;
    placeholder: "Search...";
    placeholder-color: @subtle;
    cursor: text;
}

// "No results" / errors
message {
    background-color: @red-surface;
    border-radius: 4px;
    padding: 8px 12px;
}

textbox {
    text-color: @red;
}

// List of items
listview {
    border: 0px;
    lines: 7;
    spacing: 4px;
    fixed-height: true;
    scrollbar: false;
    columns: 1;
}

// List entries
element {
    border-radius: 4px;
    padding: 10px 12px;
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @foreground-dim;
}

element selected.normal {
    background-color: @blue-surface;
    text-color: @blue;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    cursor: inherit;
}
